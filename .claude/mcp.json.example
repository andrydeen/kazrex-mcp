{
  "mcpServers": {
    "biznet": {
      "command": "node",
      "args": [
        "/ABSOLUTE/PATH/TO/kazrex-mcp/biznet-mcp-server/dist/index.js"
      ],
      "env": {
        "BIZNET_BASE_URL": "https://cust05.isokonbpm.com",
        "BIZNET_USERNAME": "YOUR_BIZNET_USERNAME",
        "BIZNET_PASSWORD": "YOUR_BIZNET_PASSWORD"
      }
    }
  }
}
