# BizNet MCP Server — Railway Environment Variables
# Set these in Railway Dashboard → Variables

# BizNet CRM connection (required)
BIZNET_BASE_URL=https://cust05.isokonbpm.com
BIZNET_USERNAME=ADMIN
BIZNET_PASSWORD=your_biznet_password_here

# API key for securing the MCP HTTP endpoint (required — set to any strong random string)
# Generate one: openssl rand -hex 32
MCP_API_KEY=your_random_secret_here

# PORT is automatically set by Railway — do not set this manually
